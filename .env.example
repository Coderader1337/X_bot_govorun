# Скопируйте в .env и заполните реальными значениями.
# Файл .env в git не коммитится.

# --- X (Twitter) Developer Portal ---
# App: OAuth 1.0a User Context + Bearer Token
# Search/all (full-archive) требует платный доступ / кредиты.
X_CONSUMER_KEY=
X_SECRET_KEY=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- DeepSeek (обязательно) ---
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=90
DEEPSEEK_QUALIFY_BATCH_SIZE=15
DEEPSEEK_MIN_SCORE=7

# --- xAI / Grok (опционально, fallback для search-бота) ---
XAI_API_KEY=
GROK_MODEL=grok-4.3
XAI_TIMEOUT=120
GROK_FALLBACK_ENABLED=1
GROK_ONLY_WHEN_QUEUE_EMPTY=1

# --- Поведение бота ---
BOT_INTERVAL_MINUTES=4
BOT_INTERVAL_JITTER=0.55
DAILY_POST_LIMIT=200
QUEUE_REFILL_THRESHOLD=5
SEARCH_LIMIT=10
SEARCH_LIMIT_URGENT=15
SPARSE_RETRY_MIN=3
EXCLUDED_IDS_IN_PROMPT=50
SEARCH_MAX_DAYS=30
SEARCH_SLICE_DAYS=5
X_SEARCH_PAGE_SIZE=100
X_SEARCH_MAX_PAGES=2
EXCLUDED_HANDLES=MoveToRussiaCom,MoveToRussia

# --- Пути ---
STATE_DB=data/bot_state.db
LOG_FILE=logs/bot.log
# BOT_VIDEO_PATH=bot/video/V23_1(2).mp4

# --- VPS (только для scripts/sync_to_vps.py с рабочей машины) ---
VPS_IP=207.244.254.188
VPS_USER=root
VPS_PASS=
VPS_PORT=22
VPS_REMOTE_ROOT=/opt/movetorussia/twitter_agent
