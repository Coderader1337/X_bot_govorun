# Скопируйте в .env и заполните реальными значениями.
# Файл .env в git не коммитится.

# --- X Developer Portal ---
# Search/all (full-archive) требует платный доступ / кредиты.
X_CONSUMER_KEY=
X_SECRET_KEY=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- DeepSeek ---
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=90
DEEPSEEK_QUALIFY_BATCH_SIZE=15
DEEPSEEK_MIN_SCORE=7

# --- Поведение ---
DAILY_POST_LIMIT=200
BOT_INTERVAL_JITTER=0.55
X_SEARCH_PAGE_SIZE=100

# --- Пути (обычно не нужны) ---
# DATA_DIR=data
# LOG_DIR=logs
# BOT_VIDEO_PATH=bot/video/V23_1(2).mp4

# --- VPS (только для scripts/sync_to_vps.py) ---
VPS_IP=207.244.254.188
VPS_USER=root
VPS_PASS=
VPS_PORT=22
VPS_REMOTE_ROOT=/opt/movetorussia/twitter_agent
